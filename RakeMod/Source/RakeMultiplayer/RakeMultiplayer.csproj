<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <AssemblyName>RakeMultiplayer</AssemblyName>
    <RootNamespace>RakeMultiplayer</RootNamespace>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity References -->
    <Reference Include="UnityEngine">
      <HintPath>D:\Rake Multiplayer\Rake\Rake_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>D:\Rake Multiplayer\Rake\Rake_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\Rake Multiplayer\Rake\Rake_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>D:\Rake Multiplayer\Rake\Rake_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- BepInEx References -->
    <Reference Include="BepInEx">
      <HintPath>D:\Rake Multiplayer\Rake\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>D:\Rake Multiplayer\Rake\BepInEx\core\BepInEx.Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>D:\Rake Multiplayer\Rake\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Telepathy Reference -->
    <Reference Include="Telepathy">
      <HintPath>D:\Rake Multiplayer\Rake\BepInEx\plugins\Telepathy.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- System References -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
</ItemGroup>

  <ItemGroup>
    <!-- Exclude test files from main build (require NUnit/Unity runtime) -->
    <Compile Remove="Tests\**" />
    <None Include="Tests\**" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(SkipCopyToGame)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="D:\Rake Multiplayer\Rake\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="D:\Rake Multiplayer\Rake\BepInEx\plugins" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>